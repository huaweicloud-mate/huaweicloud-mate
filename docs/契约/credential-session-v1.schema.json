{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:huaweicloud:agent-plugin:credential-session:v1",
  "title": "Huawei Cloud Credential Session v1",
  "oneOf": [
    {"$ref": "#/$defs/createRequest"},
    {"$ref": "#/$defs/createResponse"},
    {"$ref": "#/$defs/sessionReference"}
  ],
  "$defs": {
    "secret": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "opaque": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32,512}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accountId", "domainId"],
      "properties": {
        "accountId": {"type": "string", "minLength": 1, "maxLength": 256},
        "domainId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "accessKey", "secretKey", "credentialGeneration", "requestedTtlSeconds"],
      "properties": {
        "protocol": {"const": "huaweicloud-credential-session/v1"},
        "accessKey": {"$ref": "#/$defs/secret"},
        "secretKey": {"$ref": "#/$defs/secret"},
        "credentialGeneration": {"type": "string", "format": "uuid"},
        "requestedTtlSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        }
      }
    },
    "createResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "sessionId",
        "routeToken",
        "providerInstanceId",
        "credentialGeneration",
        "expiresAt",
        "accountIdentity"
      ],
      "properties": {
        "protocol": {"const": "huaweicloud-credential-session/v1"},
        "sessionId": {"$ref": "#/$defs/opaque"},
        "routeToken": {"$ref": "#/$defs/opaque"},
        "providerInstanceId": {"type": "string", "minLength": 1, "maxLength": 256},
        "credentialGeneration": {"type": "string", "format": "uuid"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "accountIdentity": {"$ref": "#/$defs/identity"}
      }
    },
    "sessionReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "sessionId", "routeToken"],
      "properties": {
        "protocol": {"const": "huaweicloud-credential-session/v1"},
        "sessionId": {"$ref": "#/$defs/opaque"},
        "routeToken": {"$ref": "#/$defs/opaque"}
      }
    }
  }
}
