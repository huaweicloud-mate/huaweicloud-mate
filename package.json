{
  "name": "hc-devkit",
  "version": "0.0.10",
  "description": "Huawei Cloud DevKit - MCP plugin for managing cloud resources",
  "type": "module",
  "bin": {
    "hc-devkit": "./scripts/hc-devkit.js"
  },
  "files": [
    "scripts/",
    "README.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node cloud-server/src/server.js",
    "dev": "node --watch cloud-server/src/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@huaweicloud/huaweicloud-sdk-core": "^3.1.207",
    "@huaweicloud/huaweicloud-sdk-iam": "^3.1.207",
    "@kubernetes/client-node": "^0.22.0",
    "cors": "^2.8.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.6.1",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}
