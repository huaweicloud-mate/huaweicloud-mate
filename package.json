{
  "name": "@hd_vector/huaweicloud-meta",
  "version": "1.0.9",
  "description": "Huawei Cloud Agent plugin with a dynamic MCP gateway and KooCLI fallback",
  "private": false,
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "bin": {
    "huaweicloud-mate": "build/server.js"
  },
  "files": [
    "build",
    "README.md",
    "agent.md",
    "agent-install.md"
  ],
  "scripts": {
    "build": "node scripts/clean-build.cjs && tsc",
    "generate:catalog": "node scripts/generate-catalog.cjs",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "huaweicloud",
    "huawei-cloud",
    "obs",
    "ecs",
    "mcp",
    "cloudmate",
    "koocli",
    "agent-plugin"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huaweicloud-mate/huaweicloud-mate.git"
  },
  "publishConfig": {
    "access": "public"
  }
}
