FROM node:22-alpine

RUN apk add --no-cache curl bash gcompat git

# Terraform
RUN curl -fsSL https://releases.hashicorp.com/terraform/1.11.4/terraform_1.11.4_linux_amd64.zip -o /tmp/tf.zip \
    && unzip -q /tmp/tf.zip -d /usr/local/bin/ \
    && rm /tmp/tf.zip \
    && chmod 755 /usr/local/bin/terraform

# KooCLI (hcloud)
ARG KOO_CLI_URL=https://cn-north-4-hdn-koocli.obs.cn-north-4.myhuaweicloud.com/cli/latest/hcloud_install.sh
RUN curl -fsSL ${KOO_CLI_URL} -o /tmp/hcloud_install.sh \
    && bash /tmp/hcloud_install.sh -y \
    && rm /tmp/hcloud_install.sh \
    && chmod 755 /usr/local/bin/hcloud

# Global npm packages
RUN npm install -g opencode-ai @huaweicloud/huaweicloud-sdk-core @huaweicloud/huaweicloud-sdk-apig @huaweicloud/huaweicloud-sdk-cce
ENV NODE_PATH=/usr/local/lib/node_modules

# huaweicloud-mate MCP router
COPY huaweicloud-mate/ /opt/huaweicloud-mate/
RUN cd /opt/huaweicloud-mate && npm install --omit=dev --ignore-scripts

RUN mkdir -p /workspace /skills && chmod 777 /workspace /skills
WORKDIR /workspace

COPY server/entrypoint.sh /
COPY bin/hc-devkit.js /
RUN chmod +x /entrypoint.sh

USER 1000

ENTRYPOINT ["/entrypoint.sh"]
