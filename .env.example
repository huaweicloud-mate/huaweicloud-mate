# Server Configuration
PORT=3000
NODE_ENV=production
PUBLIC_URL=http://localhost:3000

# JWT
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES=12h

# Redis (DCS)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MySQL (RDS)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=devkit

# K8s Sandbox
# KUBECONFIG=/path/to/kubeconfig
SANDBOX_IMAGE=swr.cn-south-1.myhuaweicloud.com/your-org/sandbox:latest
SANDBOX_NAMESPACE=default

# Incentive API
INCENTIVE_API_URL=https://apigw-beta.example.com
APPCODE=your-appcode
AUTH_TOKEN=your-auth-token

# Local Proxy (hc-devkit CLI)
# HDKITSERVICE_URL=http://your-server:3000/mcp
