{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "huaweicloud-obs-metamcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mentu/metamcp",
        "--config",
        "obs-plugin/.mcp.json"
      ],
      "enabled": true,
      "environment": {
        "HUAWEICLOUD_ACCESS_KEY_ID": "{env:HUAWEICLOUD_ACCESS_KEY_ID}",
        "HUAWEICLOUD_SECRET_ACCESS_KEY": "{env:HUAWEICLOUD_SECRET_ACCESS_KEY}",
        "HUAWEICLOUD_SECURITY_TOKEN": "{env:HUAWEICLOUD_SECURITY_TOKEN}",
        "HUAWEICLOUD_OBS_REGION": "{env:HUAWEICLOUD_OBS_REGION}",
        "HUAWEICLOUD_OBS_ENDPOINT": "{env:HUAWEICLOUD_OBS_ENDPOINT}",
        "HUAWEICLOUD_OBS_ENABLE_WRITE": "{env:HUAWEICLOUD_OBS_ENABLE_WRITE}",
        "HUAWEICLOUD_OBS_ENABLE_DELETE": "{env:HUAWEICLOUD_OBS_ENABLE_DELETE}",
        "HUAWEICLOUD_OBS_ENABLE_CONFIG_WRITE": "{env:HUAWEICLOUD_OBS_ENABLE_CONFIG_WRITE}"
      }
    }
  }
}
