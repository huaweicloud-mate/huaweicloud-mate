  "description": "huaweicloud-mate — Huawei Cloud Agent Plugin. Tool Router + MCP + KooCLI + Skills for AI agents.",
  "private": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
