  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "esdk-obs-nodejs": "^3.26.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "pptxgenjs": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/huaweicloud-mate/huaweicloud-mate.git"
