FROM node:22-alpine

RUN apk add --no-cache curl bash

ARG KOO_CLI_URL=https://cn-north-4-hdn-koocli.obs.cn-north-4.myhuaweicloud.com/cli/latest/hcloud_install.sh
RUN curl -fsSL ${KOO_CLI_URL} -o /tmp/hcloud_install.sh \
    && bash /tmp/hcloud_install.sh -y \
    && rm /tmp/hcloud_install.sh

RUN npm install -g opencode-ai
RUN npm install -g huaweicloud-mate@latest

RUN mkdir -p /workspace /opencode-config/skills/hw-agent-rules /skills
WORKDIR /workspace

# Agent skills + config
COPY opencode-config/skills/hw-agent-rules/SKILL.md /opencode-config/skills/hw-agent-rules/
# TODO: add huaweicloud-skills git submodule
# COPY huaweicloud-skills/skills/ /skills/

COPY cloud-server/entrypoint.sh /
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
