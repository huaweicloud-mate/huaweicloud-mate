FROM node:22-alpine

RUN apk add --no-cache curl bash wget

ARG KOO_CLI_URL=https://koolabs.obs.cn-north-4.myhuaweicloud.com/koocli/install.sh
RUN wget -q ${KOO_CLI_URL} -O /tmp/install-koocli.sh \
    && sh /tmp/install-koocli.sh \
    && rm /tmp/install-koocli.sh \
    || echo "[WARN] koocli install failed"

RUN npm install -g @opencode-ai/opencode
RUN npm install -g huaweicloud-mate@latest

RUN mkdir -p /workspace /opencode-config/skills/hw-agent-rules /skills
WORKDIR /workspace

# Agent skills + config
COPY ../opencode-config/skills/hw-agent-rules/SKILL.md /opencode-config/skills/hw-agent-rules/
COPY ../huaweicloud-skills/skills/ /skills/

COPY entrypoint.sh /
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
